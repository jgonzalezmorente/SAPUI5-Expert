<mvc:View controllerName="logaligroup.SAPUI5.controller.App"
    xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc">
    <Button id="btn" text="{i18n>showHelloButtonText}" press=".onShowHello"/>
    <Input id="input" 
           value="{/recipient/name}"
           description="{
                parts: [
                    { path: '/recipient/name' }                    
                ],
                formatter: '.formatter.hello'
           }"           
           valueLiveUpdate="true"
           width="60%"/>
</mvc:View>