<mvc:View controllerName="logaligroup.SAPUI5.controller.App"
          xmlns="sap.m" 
          xmlns:mvc="sap.ui.core.mvc"
          xmlns:core="sap.ui.core"
          displayBlock="true">
    <Shell id="shell">
        <App id="app">
            <pages>
                <Page id="page1"
                      title="{i18n>appTitle}">
                    <headerContent>
                        <Button id="helloDialogHeader" 
                                icon="sap-icon://action"
                                press=".onOpenDialogHeader" 
                                class="sapUiSmallMarginEnd"/>
                        </headerContent>
                    <content>
                        <mvc:XMLView id="_IDGenXMLView" viewName="logaligroup.SAPUI5.view.HelloPanel"/>                        
                    </content>
                </Page>
            </pages>
        </App>
    </Shell>
</mvc:View>