<mvc:View controllerName="logaligroup.SAPUI5.controller.App"
          xmlns="sap.m" 
          xmlns:mvc="sap.ui.core.mvc"
          displayBlock="true">
    <Shell id="shell">
        <App id='app'>
            <pages>
                <Page 
                    id="page1"
                    title="{i18n>appTitle}">
                    <content>
                        <Panel id="panel" headerText="{i18n>helloPanel}" class="sapUiResponsiveMargin" width="auto">
                            <content>                    
                                <Button id="btn" text="{i18n>showHelloButtonText}" press=".onShowHello" class="sapUiSmallMarginEnd"/>
                                <Input id="input" 
                                    value="{/recipient/name}"                                 
                                    valueLiveUpdate="true"
                                    width="60%"/>
                                <Text 
                                    id="text"
                                    text="{
                                        parts: [
                                            { path: '/recipient/name' }
                                        ],
                                        formatter: '.formatter.hello'
                                    }" 
                                    class="sapUiSmallMargin boldElements sapThemeBrand-asColor"/>
                            </content>                            
                        </Panel>
                    </content>
                </Page>
            </pages>
        </App>
    </Shell>
</mvc:View>