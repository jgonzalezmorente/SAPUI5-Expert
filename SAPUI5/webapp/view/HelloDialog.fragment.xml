<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog id="helloDialog" title="Hello {/recipient/name}">
        <content>
            <core:Icon id="_IDGenIcon" src="sap-icon://hello-world" size="8rem"/>
        </content>
        <beginButton>
            <Button id="_IDGenButton" text="{i18n>dialogCloseBut}" press=".onCloseDialog"/>
        </beginButton>    
    </Dialog>    
</core:FragmentDefinition>